configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    font: "JetBrainsMono Nerd Font 10";
    display-drun: ">";
    drun-display-format: "{name}";
}

/* Wipe Rofi's default theme so nothing leaks through */
@theme "/dev/null"

/* Fallback colors (used only if pywal's file fails to load) */
* {
    bg:     #191918;
    bg-alt: #72725e40;
    fg:     #c5c5c5;
    muted:  #72725e;
    accent: #568C89;
}

/* Colors generated by pywal template (overrides the fallbacks) */
@import "~/.cache/wal/colors-rofi.rasi"

* {
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 380px;
    background-color: @bg;
    border: 1px solid;
    border-color: @muted;
    border-radius: 0;
}

mainbox {
    background-color: @bg;
    children: [ inputbar, listview ];
    padding: 6px;
    spacing: 6px;
}

inputbar {
    padding: 6px 8px;
    children: [ prompt, entry ];
    spacing: 8px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "";
    text-color: @fg;
}

listview {
    border: 0;
    lines: 8;
    columns: 1;
    scrollbar: false;
    fixed-height: true;
    spacing: 2px;
}

element {
    padding: 6px 8px;
    spacing: 10px;
    border-radius: 0;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @bg-alt;
    text-color: @fg;
}

element-icon {
    size: 20px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}
